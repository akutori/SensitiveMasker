{
  "name": "sensitivemasker-gui",
  "private": true,
  "version": "0.0.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc",
    "preview": "vite preview",
    "tauri": "tauri",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:unit": "vitest run --project=unit",
    "test:stories": "vitest run --project=storybook",
    "check:dist": "bun run scripts/check-dist.ts",
    "e2e:build": "bun run scripts/generate-e2e-config.ts && VITE_E2E_TESTING=true tauri build --debug --features e2e-testing --no-bundle --config src-tauri/tauri.e2e.conf.json && cargo build -p masker",
    "e2e": "wdio run wdio.conf.ts --spec e2e/initial-setup.spec.ts && wdio run wdio.conf.ts --spec e2e/export-import.spec.ts && wdio run wdio.conf.ts --spec e2e/csp.spec.ts && wdio run wdio.conf.ts --spec e2e/profile-management.spec.ts && wdio run wdio.conf.ts --spec e2e/main-screen-file-and-clipboard.spec.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.4",
    "@tanstack/router-plugin": "^1.169.0",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.78.0",
    "monaco-editor": "^0.56.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/addon-mcp": "^10.6.8",
    "@storybook/addon-vitest": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "@wdio/cli": "^9.33.1",
    "@wdio/local-runner": "^9.33.1",
    "@wdio/mocha-framework": "^9.33.1",
    "@wdio/spec-reporter": "^9.33.1",
    "@wdio/tauri-plugin": "^1.5.1",
    "@wdio/tauri-service": "^1.5.1",
    "playwright": "latest",
    "storybook": "^10.6.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "latest"
  },
  "trustedDependencies": [
    "edgedriver"
  ],
  "overrides": {
    "dompurify": "^3.4.15",
    "@puppeteer/browsers": "^3.2.2",
    "deepmerge-ts": "^8.0.2",
    "diff": "^8.0.4",
    "serialize-javascript": "^7.1.1"
  }
}
