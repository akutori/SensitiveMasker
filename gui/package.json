    "@wdio/tauri-service": "^1.4.0",
    "playwright": "latest",
    "storybook": "^10.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "latest"
  },
  "trustedDependencies": [
    "edgedriver"
  ]
}
