{
  "compilerOptions": {
    /* tsconfig.jsonのreferencesがcompositeを要求し、compositeは出力を伴う。
       実行時はvite/wdioが.tsを直接読むため、宣言(.d.ts)だけを、ソースの隣ではなくnode_modules/.tmpへ出す */
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/tsconfig.node",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    /* e2e・wdio.conf.tsが使う、グローバルの型(describe・it・$・browser・expect)。typesを指定しないと、@types/*は自動では読み込まれない */
    "types": ["node", "@wdio/globals/types", "expect-webdriverio", "@wdio/mocha-framework", "@wdio/tauri-service"]
  },
  "include": ["vite.config.ts", "wdio.conf.ts", "e2e/**/*.ts", "scripts/**/*.ts"]
}
