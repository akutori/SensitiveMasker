{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-mask-text",
    "allow-clear-mappings",
    "allow-is-store-initialized",
    "allow-open-store",
    "allow-initialize-store",
    "allow-list-profiles",
    "allow-get-profile",
    "allow-create-profile",
    "allow-update-profile",
    "allow-delete-profile",
    "allow-set-active-profile",
    "allow-set-favorite",
    "allow-list-tags",
    "allow-create-tag",
    "allow-rename-tag",
    "allow-delete-tag",
    "allow-set-profile-tags",
    "allow-export-profile-to-file",
    "allow-export-all-to-file",
    "allow-export-profile-with-key-file",
    "allow-export-all-with-key-file",
    "allow-detect-import-method",
    "allow-preview-import-with-key-file",
    "allow-preview-import",
    "allow-commit-pending-import",
    "allow-clear-pending-import",
    "allow-write-clipboard-text",
    "allow-write-clipboard-text-untracked",
    "allow-clear-clipboard-if-matches",
    "allow-read-text-file",
    "allow-write-text-file",
    "allow-preview-env-import"
  ]
}
